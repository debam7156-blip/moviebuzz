# MOVIEBUZZ environment template
# Copy values into local.properties (repo root) — Git-ignored — or set as environment / CI variables.
# NEVER commit real keys to the repository.

# Required for TMDB metadata & discovery (free v3 key: https://www.themoviedb.org/settings/api)
MOVIEBUZZ_TMDB_API_KEY=

# Optional — LLM proxy for AI explanations (your own backend, key lives server-side)
MOVIEBUZZ_AI_ENDPOINT=

# Optional — self-hosted cloud sync endpoint (see docs/API_KEYS.md)
MOVIEBUZZ_SYNC_URL=
MOVIEBUZZ_SYNC_TOKEN=
